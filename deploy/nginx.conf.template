# meritum-frontend: the built SPA, plus /api proxied to the API container of
# the same env (API_UPSTREAM, filled in by the nginx image's envsubst at start).
server {
    listen 8080;
    root /usr/share/nginx/html;
    server_tokens off;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /api/ {
        # Docker DNS at request time: the web container starts without the API.
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $api ${API_UPSTREAM};
        proxy_pass http://$api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # meritum-gateway already replaced these with Cloudflare's client address.
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $http_connection;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    # MCP connector (backend#44): Streamable HTTP, so no buffering and a long read.
    # Authorization and X-API-Key pass through by default.
    location /mcp {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $api ${API_UPSTREAM};
        proxy_pass http://$api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-API-Key $http_x_api_key;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }

    # OAuth discovery of the MCP connector (backend#117): RFC 9728 and RFC 8414
    # metadata are served by the API, not the SPA.
    location /.well-known/oauth- {
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $api ${API_UPSTREAM};
        proxy_pass http://$api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }

    # Vite puts content-hashed files here.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # SPA: unknown paths get index.html, which is never cached.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
