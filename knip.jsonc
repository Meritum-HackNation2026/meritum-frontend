// Dead code and unused dependencies (docs/architecture.md). Run: pnpm knip
{
  "$schema": "./node_modules/knip/schema-jsonc.json",
  "entry": ["tests/**/*.test.{ts,tsx}"],
  // Copies owned by other tools or repos: shadcn components and the pnpm sync copies
  // (design-system components and contracts).
  // knip may hint that src/components/meritum/** has no issues (tests import it); keep it ignored.
  "ignore": ["src/components/ui/**", "src/components/meritum/**", "src/contracts/**"],
  "ignoreDependencies": [
    // Used by the shadcn components in src/components/ui (ignored above).
    "class-variance-authority",
    "lucide-react",
    "radix-ui",
    // dependency-cruiser's TypeScript parser (parser: "swc" in .dependency-cruiser.cjs).
    "@swc/core"
  ]
}
